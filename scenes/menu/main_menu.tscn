[node name="ControlsInfo" type="Label" parent="SettingsDialog/Margin/VBox" unique_id=1266285259]
layout_mode = 2
theme_override_font_sizes/font_size = 13
text = "• Flight: W / A / S / D (Camera-relative)
• Lateral Strafe: Q / E (Keeps nose forward)
• Altitude: Space (Climb) / Shift or C (Descend) [2.6m - 26m]
• Chaingun: Left Mouse Button (Auto-aims closest target)
• Manual Aim: Right Mouse Button (Immediate override)
• Guided Missile: F (0.95s lock acquisition)
• Thermal Flares: X (Breaks SAM & missile locks)
• Camera Orbit: J / L or Middle-Mouse Drag | Recenter: R"

